# ==========================================
# ClipForge 配置规范
# ==========================================

# 1. Google AI Studio 大脑配置
GEMINI_API_KEY=""
DEFAULT_GEMINI_MODEL="gemini-3.5-flash"

# 2. 商业配音 (TTS) 配置 (支持本地离线伴生服务 或 云端 CosyVoice 2)
TTS_PROVIDER="local"
LOCAL_TTS_BASE_URL="http://127.0.0.1:8080/v1"
COSYVOICE_API_KEY=""
COSYVOICE_BASE_URL="https://api.siliconflow.cn/v1"
COSYVOICE_DEFAULT_VOICE="FunAudioLLM/CosyVoice2-0.5B:alex"

# 3. Google Colab 专属持久化 Session 与通信配置
# 专属绑定 Session 标识 (约20字符)
COLAB_SESSION_NAME="clipforge_helloworld1234"
# 阶段 1：启动与拉取模型超限阈值 (分钟)
COLAB_BOOT_TIMEOUT_MINUTES=15
# 阶段 2：运行期无任务空闲关机阈值 (分钟)
COLAB_IDLE_TIMEOUT_MINUTES=5
# colab exec 单次命令执行最大超时时间 (秒)
COLAB_EXEC_TIMEOUT_SECONDS=600
# 本地主动向 Colab 探测心跳的周期 (秒)
COLAB_HEARTBEAT_INTERVAL_SECONDS=15
# Google Drive 视频持久化保存目录
COLAB_DRIVE_OUTPUT_DIR="/content/drive/MyDrive/ClipForge/outputs"

# 4. 数据库与本地存储
DATABASE_URL="./data/clipforge.db"
